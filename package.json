{
  "name": "mybrse-be",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.8.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "build": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --exclude tests/localstack/**",
    "test:watch": "vitest",
    "test:localstack": "pnpm localstack:up && vitest run tests/localstack",
    "localstack:up": "docker compose -f docker-compose.localstack.yml up -d",
    "localstack:down": "docker compose -f docker-compose.localstack.yml down",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm format:check && pnpm typecheck && pnpm test"
  },
  "dependencies": {
    "@aws-sdk/client-apigatewaymanagementapi": "^3.1079.0",
    "@aws-sdk/client-bedrock-runtime": "^3.1079.0",
    "@aws-sdk/client-dynamodb": "^3.1079.0",
    "@aws-sdk/client-sqs": "^3.1079.0",
    "@aws-sdk/client-translate": "^3.1079.0",
    "@aws-sdk/lib-dynamodb": "^3.1079.0",
    "zod": "^4.0.1"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.162",
    "@types/node": "^24.0.0",
    "esbuild": "^0.28.1",
    "prettier": "^3.0.0",
    "typescript": "~5.9.3",
    "vitest": "^4.1.6",
    "yaml": "^2.9.0"
  }
}
